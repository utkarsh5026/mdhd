# Copy this file to .env and fill in the values.
# Only DATABASE_URL and JWT_SECRET are required to start the server.

# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mdhd
JWT_SECRET=change-me-to-a-random-64-char-string

# --- Server ---
APP_ENV=development
RUST_LOG=info
PORT=8080
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Google OAuth (optional) ---
# Register at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Callback URL: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (optional) ---
# Register at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: http://localhost:8080/auth/github/callback
# Scopes requested at runtime: read:user, user:email, repo, admin:repo_hook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth shared ---
# Base URL of this server, used to build /auth/{provider}/callback redirect URIs
OAUTH_REDIRECT_BASE=http://localhost:8080

# --- GitHub Webhooks (optional) ---
# Public URL of this server for GitHub to send push events to.
# Leave empty in local dev — repo sync will still work manually without it.
GITHUB_WEBHOOK_BASE=

# --- Supabase S3 Storage ---
# For local dev, use MinIO: https://min.io/docs/minio/container/index.html
# For production, use your Supabase project's S3 credentials.
SUPABASE_S3_ENDPOINT=http://localhost:9000
SUPABASE_S3_ACCESS_KEY=minioadmin
SUPABASE_S3_SECRET_KEY=minioadmin
SUPABASE_STORAGE_BUCKET=files
