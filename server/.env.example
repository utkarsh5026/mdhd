# Environment selection — determines which .env.{RUN_ENV} file is loaded.
# Values: "development" (default), "production"
# RUN_ENV=development

# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mdhd
JWT_SECRET=change-me-to-a-random-64-char-string

# --- OAuth (optional for local dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8080

# --- Supabase S3 Storage (use MinIO locally) ---
SUPABASE_S3_ENDPOINT=http://localhost:9000
SUPABASE_S3_ACCESS_KEY=minioadmin
SUPABASE_S3_SECRET_KEY=minioadmin
SUPABASE_STORAGE_BUCKET=files

# --- Server ---
RUST_LOG=info
PORT=8080
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
