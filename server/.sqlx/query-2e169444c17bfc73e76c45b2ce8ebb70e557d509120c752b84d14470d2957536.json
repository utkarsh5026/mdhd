  "query": "\n                INSERT INTO users (email, name, avatar_url, oauth_provider, oauth_id)\n                VALUES ($1, $2, $3, 'google', $4)\n                ON CONFLICT (oauth_provider, oauth_id) DO UPDATE\n                SET email = EXCLUDED.email,\n                    name = EXCLUDED.name,\n                    avatar_url = EXCLUDED.avatar_url,\n                    updated_at = now()\n                RETURNING *\n                ",
