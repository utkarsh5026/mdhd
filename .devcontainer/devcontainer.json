{
  "name": "MDHD",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "installYarnUsingApt": false
    },
    "ghcr.io/shyim/devcontainers-features/bun:0": {
      "version": "1.3.9"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [5173, 8080, 8081, 5432, 9000, 9001],
  "portsAttributes": {
    "5173": { "label": "Vite Dev Server", "onAutoForward": "notify" },
    "8080": { "label": "Rust API Server", "onAutoForward": "notify" },
    "8081": { "label": "Adminer (DB UI)", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "9000": { "label": "MinIO S3 API", "onAutoForward": "silent" },
    "9001": { "label": "MinIO Console", "onAutoForward": "notify" }
  },
  "postCreateCommand": "cd app && bun install && cargo install sqlx-cli --no-default-features --features postgres && sudo apt-get update && sudo apt-get install -y postgresql-client",
  "postStartCommand": "docker compose -f server/docker-compose.dev.yml up -d",
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/mdhd",
    "SQLX_OFFLINE": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "fill-labs.dependi",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "rust-analyzer.checkOnSave": true,
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[typescript][typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  }
}
